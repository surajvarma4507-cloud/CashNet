# ============================================================================
# CASHNET (SIH26184) — Git Ignore Specification
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments & Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Node & Frontend dependencies and build outputs
node_modules/
src/frontend/node_modules/
src/frontend/dist/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/
.vite/

# Local databases and runtime state
*.db
*.sqlite
*.sqlite3
cashnet_dev.db
src/frontend/cashnet_dev.db

# Operating System & Editor Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary & Log files
*.log
*.tmp
logs/
temp/
tmp/
