# ============================================================================
# CASHNET Environment Configuration (Local & Vercel Production)
# Smart India Hackathon - SIH26184
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Backend Core & Database Settings
# ----------------------------------------------------------------------------
# Database Connection URL:
# Local Development (SQLite):
DATABASE_URL=sqlite:///./cashnet_dev.db

# Production Vercel Deployment (Hosted PostgreSQL e.g., Neon, Supabase, Vercel Postgres, AWS RDS):
# DATABASE_URL=postgresql://cashnet_user:password@ep-sample-123456.us-east-1.aws.neon.tech/neondb?sslmode=require

# Database Connection Pool Settings (Optimized for Serverless Execution)
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------------------
# 2. CORS & Network Security Settings
# ----------------------------------------------------------------------------
# Allowed origins for frontend clients (comma-separated or JSON list)
# Default is '*' (allows all origins)
CORS_ORIGINS=["*"]
# Production Example:
# CORS_ORIGINS=https://cashnet-sih26184.vercel.app,https://your-custom-domain.com

CORS_ALLOW_CREDENTIALS=true

# ----------------------------------------------------------------------------
# 3. Model & Data Paths
# ----------------------------------------------------------------------------
# Directory containing pre-trained model artifacts and feature manifest
MODELS_DIR=models

# Synthetic dataset directory for batch imports
DEFAULT_DATA_DIR=data_v2

# ----------------------------------------------------------------------------
# 4. Simulation & Safety Flags
# ----------------------------------------------------------------------------
# Declares that all cases, transactions, and predictions are synthetic prototypes
SIMULATION_MODE=true
DEBUG=false

# ----------------------------------------------------------------------------
# 5. Frontend Environment Variables (Vite)
# ----------------------------------------------------------------------------
# If deploying frontend and backend unified on the same Vercel project, leave empty
# (API requests automatically route to same-origin /api/v1 and /health).
# If deploying frontend separately on another domain, provide the full backend URL:
# VITE_API_BASE_URL=https://your-cashnet-api.vercel.app
